%% polystyle.sty -- layout of G. Metzler's lecture notes ("poly"), reproduced from
%% the poly "Statistical Supervised Machine Learning" (article class, parts,
%% blue definition boxes, dark-red theorem boxes, footer "page - title").
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{polystyle}[2026/09/23 Metzler lecture-notes style]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[english]{babel}
\RequirePackage[a4paper,top=3cm,bottom=3.2cm,left=3.2cm,right=3.2cm]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,mathtools,bm,dsfont}
\RequirePackage{graphicx,xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,decorations.pathreplacing,fit,backgrounds}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{booktabs,array,multirow}
\RequirePackage[ruled,vlined,linesnumbered]{algorithm2e}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{needspace}
\RequirePackage[round,authoryear]{natbib}
\definecolor{polylink}{RGB}{255,0,51}
\definecolor{polyblue}{RGB}{40,90,200}
\RequirePackage[colorlinks=true,linkcolor=polylink,citecolor=polylink,urlcolor=polyblue]{hyperref}
\RequirePackage[capitalise,nameinlink]{cleveref}
\RequirePackage{caption}
\captionsetup{font=small}

%% ------------------------------------------------------------ colours (plots)
\definecolor{pbblue}{HTML}{1F5F99}
\definecolor{pbred}{HTML}{C8553D}
\definecolor{pbteal}{HTML}{2A9D8F}
\definecolor{pborange}{HTML}{E9A13B}
\definecolor{pbviolet}{HTML}{6C4F9C}
\definecolor{pbgrey}{HTML}{8C8C8C}

%% ------------------------------------------------------------ parts & sections
\titleformat{\part}[display]{\raggedright\normalfont}{\Large\bfseries\partname\ \thepart}{6pt}{\LARGE}
\titlespacing*{\part}{0pt}{0pt}{20pt}
\let\oldpart\part
\renewcommand{\part}{\clearpage\oldpart}
\setlength{\parskip}{4pt}
\setlength{\emergencystretch}{2.5em}

%% ------------------------------------------------------------ boxes (same colours as the SL poly)
\tcbset{polybox/.style={enhanced,breakable,fonttitle=\bfseries\hypersetup{citecolor=white,linkcolor=white},boxrule=0.8pt,arc=2mm,
  left=3mm,right=3mm,top=2mm,bottom=2mm,before skip=10pt,after skip=10pt}}
\newtcbtheorem[number within=section]{definition}{Definition}{polybox,colback=blue!5,colframe=blue!50}{def}
\newtcbtheorem[use counter from=definition]{theorem}{Theorem}{polybox,colback=red!5,colframe=red!50!black}{thm}
\newtcbtheorem[use counter from=definition]{proposition}{Proposition}{polybox,colback=red!5,colframe=red!50!black}{prop}
\newtcbtheorem[use counter from=definition]{corollary}{Corollary}{polybox,colback=red!5,colframe=red!50!black}{cor}
\newtcbtheorem[use counter from=definition]{lemma}{Lemma}{polybox,colback=blue!5,colframe=blue!50!black}{lem}

%% pedagogical boxes (lighter, left rule)
\newtcolorbox{remark}[1][]{enhanced,breakable,colback=green!4!white,colframe=green!45!black,
  boxrule=0pt,leftrule=2.5pt,sharp corners,title={Remark #1},coltitle=green!35!black,
  colbacktitle=green!4!white,fonttitle=\bfseries,attach title to upper={\ }}
\newtcolorbox{intuition}[1][]{enhanced,breakable,colback=orange!6!white,colframe=orange!80!black,
  boxrule=0pt,leftrule=2.5pt,sharp corners,title={In a nutshell#1},coltitle=orange!60!black,
  colbacktitle=orange!6!white,fonttitle=\bfseries,attach title to upper={\ }}
\newtcolorbox{history}[1][]{enhanced,breakable,colback=black!4,colframe=black!45,
  boxrule=0pt,leftrule=2.5pt,sharp corners,title={Historical note#1},coltitle=black!75,
  colbacktitle=black!4,fonttitle=\bfseries,attach title to upper={\ }}
\newtcolorbox{keypoints}[1][]{enhanced,breakable,colback=blue!3,colframe=blue!50,boxrule=0.5pt,
  arc=2mm,title={To remember from Section~\thesection},fonttitle=\bfseries,colbacktitle=blue!12,coltitle=black}
\newtcolorbox{objectives}[1][]{enhanced,breakable,colback=white,colframe=black!35,boxrule=0.4pt,
  arc=1mm,title={About this section},fonttitle=\bfseries\small,colbacktitle=black!6,coltitle=black,fontupper=\small\itshape}
\newtcolorbox{pitfall}[1][]{enhanced,breakable,colback=red!3,colframe=red!60!black,boxrule=0pt,
  leftrule=2.5pt,sharp corners,title={Pitfall#1},coltitle=red!55!black,colbacktitle=red!3,
  fonttitle=\bfseries,attach title to upper={\ }}

%% running example (same forest throughout the notes)
\newtcolorbox{running}[1][]{enhanced,breakable,colback=teal!4!white,colframe=teal!60!black,
  boxrule=0pt,leftrule=2.5pt,sharp corners,title={Running example#1},coltitle=teal!50!black,
  colbacktitle=teal!4!white,fonttitle=\bfseries,attach title to upper={\ }}
%% quick self-assessment questions (answers in the appendix)
\newcounter{quickcheck}[section]
\renewcommand{\thequickcheck}{\thesection.\arabic{quickcheck}}
\newenvironment{quickchecks}{\Needspace{5\baselineskip}\subsection*{Check your understanding}\small
  \noindent\emph{Short questions to answer without computation; answers in Appendix~\ref{app:answers}.}\par
  \begin{list}{\bfseries Q\thequickcheck.}{\usecounter{quickcheck}\setlength{\leftmargin}{3.2em}\setlength{\labelwidth}{2.8em}\setlength{\itemsep}{2pt}}}
  {\end{list}}
%% guiding question at the top of each section
\newcommand{\guiding}[1]{\noindent\textbf{\textup{Guiding question.}} #1\par\smallskip}

%% examples, as in the SL poly: "Example 1.1." run-in
\newtheoremstyle{polyex}{8pt}{8pt}{\normalfont}{}{\itshape}{.}{0.5em}{}
\theoremstyle{polyex}
\newtheorem{example}{Example}[section]
\newtheorem{exercise}{Exercise}[section]
\newenvironment{proofsketch}{\begin{proof}[Proof sketch]}{\end{proof}}
\newenvironment{exercises}{\Needspace{6\baselineskip}\subsection*{Exercises}\small}{}

