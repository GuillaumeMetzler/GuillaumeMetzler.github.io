%% ------------------------------------------------------------ footer (as in the SL poly)
\setlist{itemsep=2pt,topsep=4pt}
\newcommand{\polytitle}{PAC-Bayesian Learning}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}
\fancyfoot[L]{\small\thepage\ -\ \ \polytitle}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0.4pt}\fancyfoot[L]{\small\thepage\ -\ \ \polytitle}}

