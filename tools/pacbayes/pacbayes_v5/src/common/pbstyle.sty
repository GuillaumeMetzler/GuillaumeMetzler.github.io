%% pbstyle.sty -- shared style for the PAC-Bayes part of "Ensemble Methods"
%% G. Metzler, Universite Lumiere Lyon 2 -- M2 MALIA
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pbstyle}[2026/09/22 PAC-Bayes course style]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[english]{babel}
\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,mathtools,bm,dsfont}
\RequirePackage{graphicx,xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,decorations.pathreplacing,fit,backgrounds}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{booktabs,array,multirow}
\RequirePackage[ruled,vlined,linesnumbered]{algorithm2e}
\RequirePackage{fancyhdr}
\RequirePackage[round,authoryear]{natbib}
\RequirePackage[colorlinks=true,linkcolor=pbblue,citecolor=pbteal,urlcolor=pbred]{hyperref}
\RequirePackage[capitalise,nameinlink]{cleveref}
\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf}

%% ---------------------------------------------------------------- colours
\definecolor{pbblue}{HTML}{1F5F99}
\definecolor{pbred}{HTML}{C8553D}
\definecolor{pbteal}{HTML}{2A9D8F}
\definecolor{pborange}{HTML}{E9A13B}
\definecolor{pbviolet}{HTML}{6C4F9C}
\definecolor{pbgrey}{HTML}{8C8C8C}

%% ---------------------------------------------------------------- boxes
\newtcbtheorem[number within=section]{definition}{Definition}{enhanced,breakable,colbacktitle=pbblue!18,coltitle=black,
  colback=pbblue!4,colframe=pbblue,fonttitle=\bfseries,sharp corners=south,
  boxrule=0.6pt}{def}
\newtcbtheorem[use counter from=definition]{theorem}{Theorem}{enhanced,breakable,colbacktitle=pbred!18,coltitle=black,
  colback=pbred!4,colframe=pbred!85!black,fonttitle=\bfseries,sharp corners=south,
  boxrule=0.6pt}{thm}
\newtcbtheorem[use counter from=definition]{proposition}{Proposition}{enhanced,breakable,colbacktitle=pbred!12,coltitle=black,
  colback=pbred!3,colframe=pbred!60!black,fonttitle=\bfseries,sharp corners=south,
  boxrule=0.5pt}{prop}
\newtcbtheorem[use counter from=definition]{lemma}{Lemma}{enhanced,breakable,colbacktitle=pbviolet!15,coltitle=black,
  colback=pbviolet!4,colframe=pbviolet,fonttitle=\bfseries,sharp corners=south,
  boxrule=0.5pt}{lem}
\newtcbtheorem[use counter from=definition]{corollary}{Corollary}{enhanced,breakable,colbacktitle=pbred!12,coltitle=black,
  colback=pbred!3,colframe=pbred!60!black,fonttitle=\bfseries,sharp corners=south,
  boxrule=0.5pt}{cor}
\newtcolorbox{remark}[1][]{enhanced,breakable,colback=pbteal!5,colframe=pbteal,
  boxrule=0pt,leftrule=2.5pt,sharp corners,title={Remark #1},coltitle=pbteal!70!black,
  colbacktitle=pbteal!5,fonttitle=\bfseries,attach title to upper={\ }}
\newtcolorbox{intuition}[1][]{enhanced,breakable,colback=pborange!7,colframe=pborange,
  boxrule=0pt,leftrule=2.5pt,sharp corners,title={In a nutshell#1},coltitle=pborange!60!black,
  colbacktitle=pborange!7,fonttitle=\bfseries,attach title to upper={\ }}
\newtcolorbox{history}[1][]{enhanced,breakable,colback=pbgrey!7,colframe=pbgrey,
  boxrule=0pt,leftrule=2.5pt,sharp corners,title={Historical note#1},coltitle=black!70,
  colbacktitle=pbgrey!7,fonttitle=\bfseries,attach title to upper={\ }}
\newtcolorbox{exercisebox}[1][]{enhanced,breakable,colback=white,colframe=pbblue!70,
  boxrule=0.5pt,sharp corners,title={#1},fonttitle=\bfseries,colbacktitle=pbblue!12,coltitle=black}

\theoremstyle{definition}
\newtheorem{example}{Example}[section]
\newenvironment{proofsketch}{\begin{proof}[Proof sketch]}{\end{proof}}

