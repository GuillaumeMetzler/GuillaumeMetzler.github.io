%% polystyle.sty -- layout of G. Metzler's lecture notes ("poly"), built on the
%% template of the poly "Statistical Supervised Machine Learning" (main.tex and
%% usercommands.tex): article class, parts, tcolorbox theorems (blue definitions,
%% dark-red theorems, green lemmas), colours bfig/rfig for links, footer
%% "page - title" with a rule, annotated derivations (\cause), coloured braces.
%% Additions for the PAC-Bayes notes: coloured section titles, part banners,
%% pedagogical boxes (running example, pitfalls, quick checks, ...).
\NeedsTeXFormat{LaTeX2e}
