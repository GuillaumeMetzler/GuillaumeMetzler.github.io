\let\oldpart\part
\renewcommand{\part}{\clearpage\oldpart}
\titleformat{\section}{\normalfont\Large\bfseries\color{bfig}}{\thesection}{0.8em}{}[{\color{bfig!60}\titlerule[0.8pt]}]
\titleformat{\subsection}{\normalfont\large\bfseries\color{bfig!80!black}}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\color{bfig!70!black}}{\thesubsubsection}{0.8em}{}
\titlespacing*{\section}{0pt}{16pt plus 4pt minus 2pt}{10pt plus 2pt}
