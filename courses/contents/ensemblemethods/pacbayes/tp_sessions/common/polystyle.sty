%% ---------------------------------------------------------------------------
%% "Check your understanding": questions in the text, answers collected
%% automatically and printed by \printanswers at the end of the document.
%%   \begin{checks}
%%     \qa{Question?}{Answer.}
%%     \item Question? \answerhint{Answer.}      % equivalent older syntax
%%   \end{checks}
%% (quickchecks and selfcheck are aliases of checks). The question number is a
%% link to the answer, and the number of the answer a link back to the question.
\RequirePackage{etoolbox}
\newcounter{quickcheck}[section]
\renewcommand{\thequickcheck}{\thesection.\arabic{quickcheck}}
\gdef\pl@allanswers{}
\gdef\pl@lastanssec{}
\gdef\currentsectiontitle{}
\AtBeginDocument{\let\pl@oldsectionmark\sectionmark
  \renewcommand{\sectionmark}[1]{\gdef\currentsectiontitle{#1}\pl@oldsectionmark{#1}}}
\newcommand{\pl@registersection}{%
  \edef\pl@tmp{\thesection}%
  \ifx\pl@tmp\pl@lastanssec\else
    \xdef\pl@lastanssec{\thesection}%
    \xappto\pl@allanswers{\noexpand\pl@anshead{\thesection}{\unexpanded\expandafter{\currentsectiontitle}}}%
  \fi}
\newcommand{\pl@addanswer}[1]{\xappto\pl@allanswers{\noexpand\pl@ansitem{\thequickcheck}{\unexpanded{#1}}}}
\newcommand{\pl@qlabel}{\hypertarget{q:\thequickcheck}{}\hyperlink{a:\thequickcheck}{\bfseries Q\thequickcheck.}}
\newenvironment{checks}{\Needspace{5\baselineskip}\subsection*{Check your understanding}\small
  \noindent\emph{Short questions to test yourself; the answers are in Appendix~\ref{app:answers} (click on the number of a question to see its answer).}\par
  \pl@registersection
  \begin{list}{\pl@qlabel}{\@nmbrlisttrue\def\@listctr{quickcheck}\setlength{\leftmargin}{3.2em}\setlength{\labelwidth}{2.8em}\setlength{\itemsep}{3pt}}}
  {\end{list}}
\newenvironment{quickchecks}{\begin{checks}}{\end{checks}}
\newenvironment{selfcheck}{\begin{checks}}{\end{checks}}
\newcommand{\qa}[2]{\item #1\pl@addanswer{#2}}
\newcommand{\answerhint}[1]{\pl@addanswer{#1}}
\newcommand{\pl@anshead}[2]{\par\Needspace{4\baselineskip}\medskip\noindent{\bfseries\color{bfig}Section~#1\ \ #2}\par\nobreak\smallskip}
\newcommand{\pl@ansitem}[2]{\par\noindent\hypertarget{a:#1}{}\hyperlink{q:#1}{\textbf{Q#1.}}\ #2\par\smallskip}
\newcommand{\printanswers}{\section{Answers to the ``Check your understanding'' questions}\label{app:answers}\label{app:pbanswers}
  \small\noindent The number of each answer is a link back to its question.\par\pl@allanswers\normalsize}

%% ---------------------------------------------------------------------------
%% Exercises and their solutions. The exercises of a section are in the file
%% chapters/exercises/ex_<file>.tex, each exercise followed by its solution in a
%% `solution' environment. The solutions are hidden in the notes (main.tex) and
%% printed in the separate document exercise_solutions.tex.
\RequirePackage{comment}
\def\CommentCutFile{\jobname.cut}
\newif\ifpolysolutions
\AtBeginDocument{\ifpolysolutions
    \specialcomment{solution}{\par\smallskip\noindent{\bfseries\color{bfig}Solution.}\ }{\par\medskip}%
  \else\excludecomment{solution}\fi}
